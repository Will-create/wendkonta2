APP_NAME=Wendkonta
APP_ENV=production
APP_KEY=GENERATED_BY_DEPLOYMENT
APP_DEBUG=false
APP_URL=https://wendkonta.logicielyaar.site
DEBUGBAR_ENABLED=false
USER_VERIFIED=true

LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=wendkonta
DB_USERNAME=wendkonta_app
DB_PASSWORD=GENERATED_BY_DEPLOYMENT

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=wendkonta
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=wendkonta_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
MAIL_DRIVER=log
