{
    "private": true,
    "scripts": {
        "test:mobile:dom": "node tests/js/mobile-shell.dom.test.cjs && node tests/js/mobile-ajax.dom.test.cjs && node tests/js/mobile-summary.dom.test.cjs && node tests/js/pwa-worker.test.cjs && node tests/js/mobile-charts.dom.test.cjs",
        "test:mobile:e2e": "python3 deploy/test_mobile.py",
        "test:followup": "node tests/js/followup.dom.test.cjs",
        "test:purchase-selection": "node tests/js/purchase-product-picker.dom.test.cjs",
        "test:mobile:pagination": "node tests/js/mobile-pagination.dom.test.cjs",
        "test:sale-selection": "node tests/js/sale-product-select.dom.test.cjs",
        "test:sale-selection:browser": "node tests/js/sale-product-select.test.mjs",
        "dev": "npm run development",
        "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
        "watch": "npm run development -- --watch",
        "watch-poll": "npm run watch -- --watch-poll",
        "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
        "prod": "npm run production",
        "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --no-progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
