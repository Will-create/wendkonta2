        "bootstrap": "^4.0.0",
        "cross-env": "^7.0",
        "jsdom": "^26.1.0",
        "jquery": "^3.2",
        "laravel-mix": "^5.0.1",
        "lodash": "^4.17.13",
        "popper.js": "^1.12",
